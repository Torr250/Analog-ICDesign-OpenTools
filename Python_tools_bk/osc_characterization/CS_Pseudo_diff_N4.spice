**** begin user architecture code


*.options method=gear
.include /foss/designs/atorralba/repo/Analog-ICDesign-OpenTools/ngspice/gf180mcuD/design.ngspice
.lib /foss/designs/atorralba/repo/Analog-ICDesign-OpenTools/ngspice/gf180mcuD/sm141064.ngspice typical
.ic v(n1)=0.6
.param VDD=3.3 TEMP=60
.temp {TEMP}
.csparam vdd1={VDD}
**** interactive sim
.control
  tran 5p 50n uic
  let vlow = {0.1*vdd1}
  let vhigh = {0.9*vdd1}
  let vswitch = {0.5*vdd1}
  meas tran period trig V(n13) val=0 td=20n rise=1 targ V(n13) val=0 td=20n rise=2
  meas tran VCS_avg AVG V(VCS) from=20n to=50n
  let freq = 1/period
  print period
  print freq
  option remzerovec
  save all
  write CS_Pseudo_diff_N4.raw
.endc


**** end user architecture code
**.ends
.GLOBAL VDD
.end
