** sch_path: /foss/designs/atorralba/cyc/gf180mcuD/analog/PLL/TB_gf180_cyc_pll_pfd_cp_div.sch
**.subckt TB_gf180_cyc_pll_pfd_cp_div
V9 net1 0 'VDD'
V7 VDD net1 0
x1 UPP REF VDD 0 FB UPN DNP DNN gf180_cyc_pll_pfd_tspc
V1 REF 0 PULSE(0 {VDD} 0 {0.01/freq} {0.01/freq} {0.5/freq} {1/freq})
x2 vctrl VDD 0 UPP net2 UPN DNP DNN vfb gf180_cyc_pll_cp_young
I0 VDD net2 {ICP}
R1 vctrl vfb {RZ}
C1 vfb 0 {CZ}
C2 vctrl 0 1p
x3 vctrl CLK vco_ideal vdd={VDD} f0={F0} kvco={KVCO} vc0={VC0} sharp=8
x4 0 CLK net3 VDD gf180_cyc_pll_div_divby4
x5 0 net3 FB VDD gf180_cyc_pll_div_divby5
**** begin user architecture code


*.options method=gear
.include /foss/designs/atorralba/repo/Analog-ICDesign-OpenTools/ngspice/gf180mcuD/design.ngspice
.lib /foss/designs/atorralba/repo/Analog-ICDesign-OpenTools/ngspice/gf180mcuD/sm141064.ngspice ss
.include /foss/designs/atorralba/cyc/gf180mcuD/analog/VCO/vco_subckts/vco_ideal_lib.spice
.param VDD=3.0 TEMP=125 freq=25meg
.param ICP=400u RZ=8k CZ=30p F0=500meg KVCO=35meg VC0=1.60
.temp {TEMP}
.csparam vdd1={VDD}
.ic v(vctrl)=0.5
**** interactive sim
.control
  tran 10p 3u uic
  option remzerovec
  save all
  write TB_gf180_cyc_pll_pfd_cp_div.raw
.endc


