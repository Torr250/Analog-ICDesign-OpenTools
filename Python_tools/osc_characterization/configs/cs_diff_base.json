// Common settings of the differential current-starved ring oscillator (CS_Pseudo_diff_N4.spice).
// Other configs inherit this one with "extends". Input-file paths are relative to THIS file.
{
  "_note": "Base: differential current-starved ring oscillator, gf180mcuD. Inherited by cs_diff_nominal.json and cs_diff_worst3.json",
  "netlist": "../CS_Pseudo_diff_N4.spice",
  "line_prefix": "I0",
  "template": "I0 VBP 0 {v}",
  "values": ["300u", "400u", "500u", "600u", "700u"],
  "ctrl_label": "I_bias (uA)",
  "ctrl_scale": 1e-6,
  "pos": "v(n1)",
  "neg": "v(n3)",
  "isupply": "i(v7)",
  "icore": "i(v1)",
  "probe": ["v(vcs)"],
  "phase_ref": "v(n13)",
  "phase_sig": ["v(n24)"],
  "phase_expected": [-90]
}
