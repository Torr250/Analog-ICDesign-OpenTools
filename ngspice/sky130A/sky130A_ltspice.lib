.param pd = '2*int((nf+1)/2) * (W/nf + 0.29u)'
.param nrd = '0.29u / W'
.param nrs = '0.29u / W'
X1 D G S B sky130_fd_pr__pfet_01v8 l=l w=w ad=ad as=as pd=pd ps=ps nrd=nrd nrs=nrs m=m
.ends


