**** begin user architecture code


*.options method=gear
.ic v(n1)=0.2
.param VDD=1.8 TEMP=60
.temp {TEMP}
.csparam vdd1={VDD}
**** interactive sim
.control
  tran 10p 30n uic
  let vlow = {0.1*vdd1}
  let vhigh = {0.9*vdd1}
  let vswitch = {0.5*vdd1}
  meas tran period trig V(n1) val=vswitch td=20n rise=1 targ V(n1) val=vswitch td=20n rise=2
  let freq = 1/period
  print period
  print freq
  option remzerovec
  save all
  write Ring_InvN3.raw
.endc


.lib /libs.tech/combined/sky130.lib.spice tt
**** end user architecture code
**.ends
.GLOBAL VDD
.end
