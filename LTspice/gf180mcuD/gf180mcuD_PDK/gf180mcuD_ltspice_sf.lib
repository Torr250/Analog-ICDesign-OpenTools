* model for unsalicided p+ diffusion resistor

* ---- subcircuitos con mismatch (nativo: .lib fets_mm) ----
.subckt nfet_03v3 d g s b w=1e-5 l=2.8e-7 nf=1 m=1
+ as=0 ad=0 ps=0 pd=0 nrd=0 nrs=0 par=1 dtemp=0
+ sa=0 sb=0 sd=0

.param
+ par_vth=0.007148
+ par_k=0.007008
+ par_l=1.5e-7
+ par_w=-1e-7
+ par_leff='l-par_l'
+ par_weff='par*(w-par_w)'
+ p_sqrtarea='sqrt((par_leff)*(par_weff))'

.param
+ var_k='0.7071*par_k* 1e-06 / p_sqrtarea'
+ mis_k={gauss((var_k)/(1))}

.param
+ var_vth='0.7071*par_vth* 1e-06 / p_sqrtarea'
+ mis_vth={gauss((var_vth)/(1))}

m0 d g s b nfet_03v3 w='w' l='l' as='as' ad='ad' ps='ps' pd='pd' nrd='nrd' nrs='nrs' sa='sa' sb='sb' nf='nf' sd='sd' m='m'
+delvto='mis_vth*sw_stat_mismatch'
.ends nfet_03v3

